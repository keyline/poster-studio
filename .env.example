# Required: your OpenAI API key (keep it secret, never commit it)
OPENAI_API_KEY=sk-...

# Optional: a shared password your team types once to use the app.
# Strongly recommended once deployed, so strangers can't spend your credits.
APP_PASSWORD=

# Optional model overrides
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
