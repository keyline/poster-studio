# Required: your OpenAI API key (keep it secret, never commit it)
OPENAI_API_KEY=sk-...

# Recommended: a shared password your team types once to use the app.
APP_PASSWORD=

# Optional: share brands across the team via Redis (Vercel → Storage sets these).
# Either REDIS_URL, or the Upstash REST pair. Without them brands stay in each browser.
REDIS_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional model overrides
OPENAI_TEXT_MODEL=gpt-4.1
OPENAI_IMAGE_MODEL=gpt-image-1-mini

# Maximum estimated cost per image in USD (quality is lowered automatically to fit)
MAX_IMAGE_COST_USD=0.04
